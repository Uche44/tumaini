# Tumaini Backend Environment Variables
PORT=8000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./tumaini.db

# Provider Credentials
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
# HF inference API base. router.huggingface.co is the current host
# (api-inference.huggingface.co no longer resolves). Chat completions at /v1.
HUGGINGFACE_API_BASE=https://router.huggingface.co
GRADIUM_API_KEY=your_gradium_api_key_here
GRADIUM_BASE_URL=https://api.gradium.ai
